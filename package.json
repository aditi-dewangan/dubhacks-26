{
  "name": "kiosk-access",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev:server": "pnpm --filter @kiosk-access/server dev",
    "dev:kiosk": "pnpm --filter @kiosk-access/kiosk dev",
    "smoke": "pnpm --filter @kiosk-access/server smoke",
    "fake-phone": "pnpm --filter @kiosk-access/server fake-phone",
    "fake-kiosk": "pnpm --filter @kiosk-access/sdk fake-kiosk",
    "typecheck": "pnpm -r typecheck",
    "test:bridge": "pnpm --filter @kiosk-access/server test:bridge",
    "test:sdk": "pnpm --filter @kiosk-access/sdk test"
  }
}
