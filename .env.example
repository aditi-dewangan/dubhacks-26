# ---- apps/server ----
PORT=3001
# Shared secret every kiosk sends when it registers
KIOSK_KEY=dev-kiosk-key
# Where the phone app is hosted; the QR code points here
PHONE_APP_URL=http://localhost:5174
# Comma-separated origins allowed to call the server (kiosk, phone, dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Enables GET /api/dev/pairing/:kioskId for test scripts. Leave off in the demo.
DEV_ROUTES=1
# Agent (server only). Set stub for deterministic realtime smoke tests.
AGENT_MODE=gemini
GEMINI_API_KEY=
# Override with a model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
# Legacy fallback if GEMINI_API_KEY is unset
LLM_API_KEY=

# ---- apps/kiosk (Vite reads VITE_ vars) ----
VITE_SERVER_URL=http://localhost:3001
VITE_KIOSK_ID=store42-kiosk1
VITE_KIOSK_KEY=dev-kiosk-key
# Kiosk inactivity timeout when no accessible session (ms). Shorten to test "Still there?".
VITE_IDLE_MS=90000
VITE_STILL_THERE_MS=20000
